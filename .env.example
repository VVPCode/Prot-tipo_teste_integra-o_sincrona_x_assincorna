# Copie para .env e ajuste. Todo valor aqui e um parametro controlado do
# experimento e deve ser registrado junto dos resultados (item f, secao 3.4).
# As versoes efetivamente utilizadas ficam em resultados/<execucao>/metadados.json
# e devem ser transcritas no Quadro 4.

IMAGEM_RABBITMQ=rabbitmq:4.3.6-management
IMAGEM_POSTGRES=postgres:18.6
IMAGEM_K6=grafana/k6:2.2.0
RABBITMQ_USUARIO=exp
RABBITMQ_SENHA=exp
POSTGRES_USUARIO=exp
POSTGRES_SENHA=exp
POSTGRES_BANCO=exp

# --- Variaveis controladas (Quadro 5) -------------------------------------

# Tempo de processamento artificial fixo, como declara a secao 3.2.1. Representa
# as etapas de negocio que o experimento nao reproduz; a validacao e a gravacao
# no PostgreSQL somam-se a ele.
TEMPO_PROCESSAMENTO_MS=50
TEMPO_CPU_MS=0

# Capacidade de processamento simultaneo do consumidor: semaforo na via sincrona
# e prefetch do AMQP na assincrona. A capacidade teorica e
# CONCORRENCIA / (TEMPO_PROCESSAMENTO_MS + gravacao) e precisa cair entre C2
# (100 pedidos/s) e C3 (200 pedidos/s), para que a saturacao fique no interior da
# faixa examinada (secao 3.4). Com 50 ms mais alguns milissegundos de gravacao, a
# previsao e de cerca de 145 pedidos/s; o piloto confirma.
CONCORRENCIA=8

# Conjunto de conexoes com o banco, igual a concorrencia: menor seria gargalo
# escondido, maior nao seria usado.
POOL_BANCO=8

# Tempo limite identico nas duas chamadas sincronas e no gerador, cerca de 18
# vezes o tempo de uma operacao. Precisa ser declarado na secao 3.2.2.
TEMPO_LIMITE_MS=1000

MENSAGEM_PERSISTENTE=1
BACKLOG=2048

# Tamanho alvo do corpo do pedido em JSON, variavel independente de dois niveis:
# 500 e 5000 bytes. O script de execucao percorre os dois.
TAMANHO_MENSAGEM=500

# Cauda do cenario C6: tempo a 50 pedidos/s depois do pico, dimensionada para
# que a fila se esvazie dentro da execucao. Com pico de 250 o minuto de
# sobrecarga acumula cerca de 6.800 mensagens, que escoam a cerca de 64 por
# segundo - perto de 110 s. Os 4 min cobrem isso com folga e mantem C6 em cerca
# de 6 min, como o Quadro 6 declara.
C6_CAUDA=4m

# --- Limites de recursos por conteiner ------------------------------------
# Somam 10 CPUs nas 12 threads do notebook do Quadro 4. Nenhum componente de
# infraestrutura pode ser o saturado: banco saturado esconde a diferenca entre
# os estilos e produtor saturado esconde parte da latencia (secao 3.6).

# Numero de processos do produtor. Um unico laco de eventos nao passa de um
# nucleo, o que tornaria o produtor o gargalo da via sincrona.
WORKERS_PRODUTOR=4
CPU_PRODUTOR=4.0

CPU_SERVICO=1.0
MEM_SERVICO=512m
CPU_BROKER=2.0
MEM_BROKER=1g
CPU_POSTGRES=1.0
MEM_POSTGRES=1g

# Limites do gerador de carga, executado em processo apartado
CPU_CARGA=2.0
MEM_CARGA=512m
